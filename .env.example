# Familiez Docker Compose Environment Variables
# Copy this file to .env and replace placeholder values
# DO NOT COMMIT .env TO GIT!

# ----- Database Configuration -----
DB_ROOT_PASSWORD=CHANGE_ME
DB_NAME=humans
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# ----- Synology SSO Configuration -----
# Client ID and Secret from Synology SSO Server (Toepassing tab)
SYNOLOGY_CLIENT_ID=CHANGE_ME
SYNOLOGY_CLIENT_SECRET=CHANGE_ME

# Redirect URI - must match SSO application configuration
SYNOLOGY_REDIRECT_URI=http://192.168.1.89:5173/auth/callback

# ----- Synology LDAP Configuration -----
# LDAP connection details for role authorization
SYNOLOGY_LDAP_URL=ldaps://192.168.1.10:636
SYNOLOGY_LDAP_BIND_DN=uid=root,cn=users,dc=dekknet,dc=com
SYNOLOGY_LDAP_BIND_PASSWORD=CHANGE_ME
SYNOLOGY_LDAP_GROUP_ADMIN_DN=cn=Familiez_Admin,cn=groups,dc=dekknet,dc=com
SYNOLOGY_LDAP_GROUP_USER_DN=cn=Familiez_Users,cn=groups,dc=dekknet,dc=com
SYNOLOGY_LDAP_MEMBER_DN_TEMPLATE=uid={username},cn=users,dc=dekknet,dc=com
SYNOLOGY_LDAPTLS_REQCERT=never
SYNOLOGY_LDAP_TIMEOUT=8

# ----- Frontend Configuration -----
VITE_SYNOLOGY_AUTH_URL=https://sso.dekknet.com
VITE_SYNOLOGY_DISCOVERY_URL=https://sso.dekknet.com/webman/sso/.well-known/openid-configuration
VITE_API_BASE=http://192.168.1.89:8000
